{
    "unique_name": "definition_activity_02STEVTO5IV4O3W953tFZc1YVLVsXNf6VZF",
    "name": "Execute Python Script",
    "title": "Execute Python Script",
    "type": "python3.script",
    "base_type": "activity",
    "properties": {
        "action_timeout": 180,
        "continue_on_failure": false,
        "description": "Execute Python Script",
        "display_name": "Execute Python Script",
        "script": "import json\nresp_data = json.loads(\"\"\"$activity.definition_activity_02STEP2RKCLRJ3h3GBGnjAZeDYRoqm6apb1.output.response_body$\"\"\")\n# Initialize the list\naps = []\n\n# Access the data list\ncapwap_list = resp_data.get(\"Cisco-IOS-XE-wireless-access-point-oper:access-point-oper-data\", {}).get(\"capwap-data\", [])\n\nfor item in capwap_list:\n    try:\n        # Basic fields - Note: 'wtp-name' is often the key in this YANG model\n        name = item.get(\"name\", \"Unknown\") \n        radio_mac = item.get(\"wtp-mac\", \"\")\n        \n        # Nested fields\n        meraki_info = item.get(\"meraki-info\", {})\n        meraki_serial = meraki_info.get(\"serial-num\", \"\") # Verify field name in YANG\n        \n        # Check deep device details\n        device_detail = item.get(\"device-detail\", {})\n        static_info = device_detail.get(\"static-info\", {})\n        \n        # Model\n        model = static_info.get(\"ap-models\", {}).get(\"model\", \"Unknown\")\n        \n        # Eth MAC & Serial\n        board_data = static_info.get(\"board-data\", {})\n        eth_mac = board_data.get(\"wtp-enet-mac\", \"\")\n        serial = board_data.get(\"wtp-serial-num\", \"\")\n        \n        # Logic: Filter for Meraki-capable APs\n        if meraki_serial:\n            ap_data = {\n                'name': name,\n                'model': model,\n                'radio_mac': radio_mac,\n                'eth_mac': eth_mac,\n                'serial': serial,\n                'meraki_serial': meraki_serial\n            }\n            aps.append(ap_data)\n            \n    except Exception as e:\n        print(f\"Error processing AP: {e}\")\n        continue\n\n# Final array of Meraki serials\nap_sn_array = [x['meraki_serial'] for x in aps]",
        "script_queries": [
            {
                "script_query": "aps",
                "script_query_name": "wlc_aps",
                "script_query_type": "array"
            },
            {
                "script_query": "ap_sn_array",
                "script_query_name": "ap_sn_array",
                "script_query_type": "array"
            }
        ],
        "skip_execution": false
    },
    "object_type": "definition_activity"
},
